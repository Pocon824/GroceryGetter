# --- Secrets and private data (never commit) ---
.env
.env.*
!.env.example
data/*
!data/.gitkeep
inbox/**/*
!inbox/**/
!inbox/**/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.egg-info/
build/
dist/

# --- Node / Angular ---
node_modules/
.angular/
frontend/dist/
frontend/coverage/
npm-debug.log*

# --- Playwright ---
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/

# --- Editors / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
